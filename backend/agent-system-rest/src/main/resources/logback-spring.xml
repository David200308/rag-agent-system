<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Read service name from Spring config so it appears in every log line -->
    <springProperty scope="context" name="appName"
                    source="spring.application.name" defaultValue="rag-agent-system"/>

    <!--
        Console appender with structured correlation fields.

        %X{traceId} and %X{spanId} are injected into MDC automatically by
        micrometer-tracing-bridge-otel when a request is traced.
        They appear as "-" on non-traced threads (startup, scheduler, etc.).

        Format per line:
          TIMESTAMP  LEVEL  [service]  [traceId,spanId]  [thread]  logger - message
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ} %-5level [${appName}] [%X{traceId:--},%X{spanId:--}] [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Reduce noise from framework internals -->
    <logger name="org.springframework"           level="WARN"/>
    <logger name="org.springframework.web"       level="INFO"/>
    <logger name="org.springframework.ai"        level="INFO"/>
    <logger name="org.bsc.langgraph4j"           level="DEBUG"/>
    <logger name="io.weaviate"                   level="WARN"/>
    <logger name="com.zaxxer.hikari"             level="WARN"/>
    <logger name="org.hibernate"                 level="WARN"/>

    <!-- Application code at DEBUG so all [AgentController] / [RateLimitFilter] lines appear -->
    <logger name="com.agentsystem" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
