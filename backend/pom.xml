<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.agentsystem</groupId>
    <artifactId>skyproton-agent-system</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>skyproton-agent-system</name>
    <description>SkyProton Agent System — multi-module aggregator (agent-system-rest, storage-inner, notification-consumer, auth-inner, finance-inner)</description>

    <modules>
        <module>agent-system-rest</module>
        <module>storage-inner</module>
        <module>notification-consumer</module>
        <module>auth-inner</module>
        <module>finance-inner</module>
        <module>travel-inner</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!--
            Check https://central.sonatype.com/artifact/org.springframework.ai/spring-ai-bom
            for the latest Spring AI version before building.
        -->
        <spring-ai.version>1.1.8</spring-ai.version>
        <langgraph4j.version>1.8.11</langgraph4j.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <aws-sdk.version>2.29.52</aws-sdk.version>

        <!--
            Security overrides (Snyk, 2026-11). Boot 3.5.16 is the last OSS 3.x release and its
            managed versions of these libraries carry known CVEs; each property below bumps a
            Boot-managed version to the first patched release on the same minor line. Remove an
            override once the Boot parent manages an equal or newer version (i.e. after Boot 4).
        -->
        <tomcat.version>10.1.61</tomcat.version>
        <netty.version>4.1.140.Final</netty.version>
        <jackson-bom.version>2.21.8</jackson-bom.version>
        <logback.version>1.5.38</logback.version>
        <httpclient5.version>5.6.5</httpclient5.version>
        <httpcore5.version>5.4.4</httpcore5.version>
        <hibernate-validator.version>8.0.6.Final</hibernate-validator.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <json-smart.version>2.6.1</json-smart.version>
        <micrometer.version>1.16.8</micrometer.version>
        <opentelemetry.version>1.68.0</opentelemetry.version>
        <kotlin.version>2.1.21</kotlin.version>
        <!-- Not Boot-managed; pinned in dependencyManagement below -->
        <bouncycastle.version>1.86</bouncycastle.version>
        <grpc.version>1.79.0</grpc.version>
        <mcp-sdk.version>0.18.5</mcp-sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                Security pins for transitive deps that Boot does not manage (Snyk, 2026-11).
                Declared before spring-ai-bom so these BOM imports win (first import wins).
                Sources: grpc/guava via Weaviate client, MCP SDK via spring-ai-mcp,
                bouncycastle/junrar/asm via Tika, lz4/zstd/snappy via kafka-clients.
            -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp-bom</artifactId>
                <version>${mcp-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcutil-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcjmail-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.8.0-jre</version>
            </dependency>
            <dependency>
                <groupId>com.github.junrar</groupId>
                <artifactId>junrar</artifactId>
                <version>7.6.1</version>
            </dependency>
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm</artifactId>
                <version>9.11.1</version>
            </dependency>
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>1.11.4</version>
            </dependency>
            <dependency>
                <groupId>com.github.luben</groupId>
                <artifactId>zstd-jni</artifactId>
                <version>1.5.7-26</version>
            </dependency>
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>1.1.10.12</version>
            </dependency>
            <dependency>
                <groupId>org.objenesis</groupId>
                <artifactId>objenesis</artifactId>
                <version>3.6</version>
            </dependency>
            <!-- okio via resend-java's okhttp (notification-consumer) -->
            <dependency>
                <groupId>com.squareup.okio</groupId>
                <artifactId>okio</artifactId>
                <version>3.18.2</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okio</groupId>
                <artifactId>okio-jvm</artifactId>
                <version>3.18.2</version>
            </dependency>
            <!--
                spring-ai-bom 1.1.x and com.yubico:yubico-util:2.5.3 pull in
                jackson-dataformat-cbor:2.18.5, whose POM references jackson-databind:2.19.5-SNAPSHOT
                which does not exist and breaks Docker offline builds. Pin the BOM and the
                specific CBOR artifact to the Boot-managed ${jackson-bom.version} (2.21.x on
                Boot 3.5.16) so the broken 2.18.5 POM is never resolved.
            -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-cbor</artifactId>
                <version>${jackson-bom.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
            <id>spring-snapshots</id>
            <name>Spring Snapshots</name>
            <url>https://repo.spring.io/snapshot</url>
            <releases><enabled>false</enabled></releases>
        </repository>
    </repositories>
</project>
