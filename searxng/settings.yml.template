# Self-hosted SearXNG instance used only by the backend's WebSearchAgentTool —
# reachable on the docker-internal network only, never exposed as a public
# search engine. json format is enabled here specifically so the backend can
# query /search?format=json (SearXNG's own defaults disable json since public
# instances shouldn't allow bulk scraping — doesn't apply to a private instance).
#
# Rendered into searxng/settings.yml by setup.sh (same __PLACEHOLDER__ + sed
# pattern as observability/garage/garage.toml.template). The rendered file is
# git-ignored since it embeds a real secret_key; this template is the only
# copy that's committed.
use_default_settings: true

general:
  instance_name: "agent-system-searxng"

search:
  formats:
    - html
    - json

server:
  secret_key: "__SEARXNG_SECRET_KEY__"
  limiter: false
  image_proxy: false

# Disable engines that don't work in this deployment:
#   - ahmia, torch: .onion-only search engines, need a Tor proxy sidecar we don't run.
#   - startpage: frequently CAPTCHA-blocks datacenter/cloud IPs and, on failure, self-
#     suspends for an hour (suspended_time=3600) — every query in that window still
#     pays its per-engine timeout for nothing. duckduckgo CAPTCHAs occasionally too but
#     doesn't self-suspend, so it's left enabled.
# `name:` must match the engine's default name exactly (see SearXNG's own
# searx/settings.yml for the full default list) — entries here only override
# those defaults, via use_default_settings' engines merge.
engines:
  - name: ahmia
    disabled: true
  - name: torch
    disabled: true
  - name: startpage
    disabled: true
