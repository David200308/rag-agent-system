# Rendered into observability/garage/garage.toml by setup.sh (which substitutes
# __GARAGE_RPC_SECRET__ / __GARAGE_ADMIN_TOKEN__ with generated values). The
# rendered file contains secrets and is gitignored — this template is not.
metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"

replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "garage:3901"
rpc_secret = "__GARAGE_RPC_SECRET__"

[s3_api]
s3_region = "garage"
api_bind_addr = "[::]:3900"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "__GARAGE_ADMIN_TOKEN__"
